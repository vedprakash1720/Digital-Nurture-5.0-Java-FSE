class Logger {

    // Private static instance of Logger class
    private static Logger instance;

    // Private constructor
    private Logger() {
        System.out.println("Logger object created");
    }

    // Public static method to get Logger instance
    public static Logger getInstance() {

        if (instance == null) {
            instance = new Logger();
        }

        return instance;
    }

    // Method for logging messages
    public void log(String message) {
        System.out.println("LOG: " + message);
    }
}


public class LoggerTest {

    public static void main(String[] args) {

        // Getting Logger objects
        Logger logger1 = Logger.getInstance();
        Logger logger2 = Logger.getInstance();

        // Using Logger
        logger1.log("Application Started");
        logger2.log("User Logged In");

        // Checking Singleton property
        if (logger1 == logger2) {
            System.out.println("Only one Logger instance is created.");
        } 
        else {
            System.out.println("Multiple Logger instances are created.");
        }
    }
}
